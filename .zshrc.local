#                                   EXECUTE                                    #
#==============================================================================#


IFS='' read -r -d '' _TODOS < <( todos ) || : EOF
if [[ -n $_TODOS ]] {
	if [[ $TERM =~ (alacritty|foot|konsole) ]] {
		printf "$setaf[12]$terminfo[sgr0]\n%b" $_TODOS
	} else {
		printf "$setaf[12]Todos:$terminfo[sgr0]\n%b" $_TODOS
	}
} ; unset -v _TODOS


