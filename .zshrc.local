#!/hint/zsh
# vim:ft=zsh:noet:ts=3:sw=3:
# man:zsh(1)
# file:$HOME/.zshrc.local
#==============================================================================#


[[ -o interactive ]] || return # not interactive

# defaults
export DIFFPROG="diff -dNu"
export EDITOR="vim"
export PAGER="less"
export VISUAL="vim"

# man:gpg-agent(1)
export GPG_TTY=$TTY
gpg-connect-agent UPDATESTARTUPTTY /bye &>/dev/null || : NOERR

# force console password query
if [[ $TERM =~ (linux|tmux|xterm) ]] {
	# man:gpg(1) (custom)
	export PINENTRY_USER_DATA="nogui"
	# man:ssh(1)
	export SSH_ASKPASS_REQUIRE="never"
}

