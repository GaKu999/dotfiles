#!/hint/bash
# vim:ft=bash:noet:ts=3:sw=3:
# file:$HOME/.bashenv
#==============================================================================#


# store the current terminal device
# man:tty(1)
readonly TTY="$( tty )"

set -a
	# XDG user dirs
	: ${XDG_CACHE_HOME:=$HOME/.cache}
	: ${XDG_CONFIG_HOME:=$HOME/.config}
	: ${XDG_DATA_HOME:=$HOME/.share}
	: ${XDG_STATE_HOME:=$HOME/.state}

	: ${XDG_BIN_DIR:=$HOME/.bin}
	: ${XDG_LIB_DIR:=$HOME/.lib}

	XDG_CONFIG_DIRS="$XDG_CONFIG_HOME:$PREFIX/etc/xdg"
	XDG_DATA_DIRS="$XDG_DATA_HOME:$PREFIX/share"
set +a

# default to dumb
[[ -n "$TERM" ]] || export TERM="dumb"

# enable 16 color support in the linux console
# bold is bright foreground, blink is bright background
if [[ "$TERM" =~ linux ]] ; then
	export TERM="linux-16color"
fi

# always use 256color
if [[ "$TERM" =~ xterm ]] ; then
	export TERM="xterm-256color"
fi

# append a dir to $PATH
# $*: PATHS
function _append_paths { local path
	local _PATH="$PATH"
	for path ; do
		[[ -d "$path" ]] || return 2
		if [[ ":$_PATH:" != *":$path:"* ]] ; then
			_PATH="${_PATH:+$_PATH:}$path"
		fi
	done
	if [[ "$_PATH" != "$PATH" ]] ; then
		PATH="$_PATH"
	fi
}

# setup $PATH
_append_paths "$XDG_BIN_DIR"
export PATH ; unset -f _append_paths

if [[ "$-" == *i* ]] ; then
	# store capabilities for $TERM
	declare -A terminfo
	while IFS='#' read -r str cap ; do
		terminfo[$str]="$cap"
	done < <( terminfo-cache )
	readonly terminfo

	# $1: CAPABILITY
	function echoti { echo -n "${terminfo[$1]}" ; }

	# color setup
	mapfile -t setaf < <( printf 'setaf %s\nind\n' {0..255} | tput -S 2> /dev/null )
	mapfile -t setab < <( printf 'setab %s\nind\n' {0..255} | tput -S 2> /dev/null )
	readonly setaf setab

	# $1: CODE {0..255}
	function setaf { local -ir i="$1" ; echo -n "${setaf[$i]}" ; }
	function setab { local -ir i="$1" ; echo -n "${setab[$i]}" ; }

	# plain color codes
	mapfile -t _af < <( printf '%s\n' "${setaf[@]}" | tr -d '\033[m' )
	mapfile -t _ab < <( printf '%s\n' "${setab[@]}" | tr -d '\033[m' )
	readonly _af _ab
fi


#==============================================================================#
#                                 END OF FILE                                  #
#==============================================================================#
