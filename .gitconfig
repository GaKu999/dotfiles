# vim:ft=gitconfig:
# man:git-config(1)
# file:$XDG_CONFIG_HOME/git/config
#==============================================================================#


[user]
name=user
email=user@termux

[blame]
date=format:%Y-%m-%d %H:%M

[log]
date=format:%Y-%m-%d %H:%M

[format]
numbered=auto

[color]
branch=yes
diff=auto
pager=yes
status=auto

[init]
defaultBranch=main


#==============================================================================#
#                                 END OF FILE                                  #
#==============================================================================#
