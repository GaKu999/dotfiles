#!/bin/sh
# vim:ft=sh:noet:ts=3:sw=3:
# file:$XDG_CONFIG_HOME/niri/startup
#==============================================================================#


(
	systemctl -q --user import-environment NIRI_SOCKET DISPLAY WAYLAND_DISPLAY
	dbus-update-activation-environment --systemd NIRI_SOCKET DISPLAY WAYLAND_DISPLAY
	systemctl -q --user start niri-session.target
) &

# man:swaybg(1)
swaybg -o '*' -i "$HOME/.wallpaper" -m fill -c "#1d2021" &

# man:wlr-randr(1)
