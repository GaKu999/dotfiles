# vim:ft=dosini:
# man:dunst(5)
# file:$XDG_CONFIG_HOME/dunst/dunstrc
#==============================================================================#


[global]
monitor=0

width=512
#height=(0, X)

origin=top-right

offset=(2, 32)

scale=0

notification_limit=0

indicate_hidden=no

transparency=5

separator_height=2

padding=0

horizontal_padding=2

text_icon_padding=0

frame_width=2

frame_color="#282828"

gap_size=2

separator_color=frame

sort=yes

font=sans-serif 15

line_height=0

markup=full

format="<b>%s</b>\n%b"

alignment=left

vertical_alignment=center

show_age_threshold=-1

ellipsize=middle

word_wrap=yes

ignore_newline=no

stack_duplicates=no

hide_duplicate_count=no

show_indicators=no

enable_recursive_icon_lookup=yes

icon_position=off

min_icon_size=32

max_icon_size=128

sticky_history=no

history_length=10000

dmenu=dmenu -p dunst:

browser=xdg-open

always_run_script=no

title=Dunst

class=Dunst

corner_radius=0

corners=all

ignore_dbusclose=false

layer=overlay

force_xwayland=no

force_xinerama=no

mouse_left_click=close_current
mouse_middle_click=close_current
mouse_right_click=close_all

[experimental]
per_monitor_dpi=false

[urgency_low]
background="#1d2021"
foreground="#ebdbb2"
timeout=15

[urgency_normal]
background="#1d2021"
foreground="#ebdbb2"
timeout=15
override_pause_level=30

[urgency_critical]
background="#1d2021"
foreground="#ebdbb2"
frame_color="#fabd2f"
timeout=15
override_pause_level=60


#==============================================================================#
#                                 END OF FILE                                  #
#==============================================================================#
