# vim:ft=confini:
# man:mako(5)
# file:$XDG_CONFIG_HOME/mako/config
#==============================================================================#


include=~/.config/mako/themes/default

anchor=top-right
layer=top
max-visible=8

sort=-priority
sort=-time

icons=0

font=sans-serif 10
markup=1

actions=0

border-size=2
margin=2
padding=0

default-timeout=15000
ignore-timeout=1

height=1024
width=512

format=<b>%s</b>\n%b


