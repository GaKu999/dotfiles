#!/bin/sh
# vim:ft=sh:noet:ts=3:sw=3:
# file:$XDG_BIN_DIR/niridpms
#==============================================================================#


# Who am I?
_SELF="${0##*/}"

_herecat() {
	local msg line lfcr
	lfcr="$( printf '%b' "\012\015" )"
	while IFS="$lfcr" read -r line ; do
		msg="$msg$line$lfcr"
	done
	printf '%s' "$msg"
}

# [$1: EXIT CODE (0)]
_usage() { local ec="${1:-0}"
	_herecat << ENDUSAGEMSG
Usage: $_SELF [{all,OUTPUT} (all)] [{toggle,on,off} (toggle)]
ENDUSAGEMSG
	exit "$ec"
}


#==============================================================================#


# $@: [{all,OUTPUT} (all)] [{toggle,on,off} (toggle)]
main() { local output="${1:-all}" action="${2:-toggle}"
	echo $action
	if [ -n "$NIRI_SOCKET" ] ; then
		case "$action" in
			toggle )
				case "$output" in
					all )
						case "$( nirimsg -j outputs | jq -r '.[].current_mode' )" in
							*null* ) main all on ;;
							* ) main all off ;;
						esac
					;;
					* )
						case "$( nirimsg -j outputs | jq -r ".[] | select(.name==\"$output\").current_mode")" in
							*null* ) main "$output" on ;;
							* ) main "$output" off ;;
						esac
					;;
				esac
			;;
			on )
				case "$output" in
					all ) nirimsg action power-on-monitors ;;
					* ) nirimsg output "$output" on ;;
				esac
			;;
			off )
				case "$output" in
					all ) nirimsg action power-off-monitors ;;
					* ) nirimsg output "$output" off ;;
				esac
			;;
			* )
				echo "$_SELF: unknown action -- '$action'" >&2
				_usage 2
			;;
		esac
	else
		echo "$_SELF: Unable to retrieve socket path" >&2
		return 1
	fi
} ; main "$@"


#==============================================================================#
#                                 END OF FILE                                  #
#==============================================================================#
