#!/bin/sh
# vim:ft=sh:noet:ts=3:sw=3:
# file:$XDG_BIN_DIR/unicode
#==============================================================================#


# Who am I?
_SELF="${0##*/}"

_herecat() {
	local msg line lfcr
	lfcr="$( printf '%b' "\012\015" )"
	while IFS="$lfcr" read -r line ; do
		msg="$msg$line$lfcr"
	done
	printf '%s' "$msg"
}

# [$1: EXIT CODE (0)]
_usage() { local ec="${1:-0}"
	_herecat << ENDUSAGEMSG
Usage: $_SELF [{get,clip,type} (get)]
ENDUSAGEMSG
	exit "$ec"
}

_uniget() {
	local query
	if [ "$XDG_SESSION_TYPE" = wayland ] && [ -n "$WAYLAND_DISPLAY" ] ; then
		query="$( uni search -f '%(char)' -q "$( wmenu -p "Search unicode character:" < /dev/null )" 2> /dev/null )"
		[ -n "$query" ] && printf '%s\n' "$query" | wmenu -p "Select unicode character:"
	elif [ "$XDG_SESSION_TYPE" = x11 ] && [ -n "$DISPLAY" ] ; then
		query="$( uni search -f '%(char)' -q "$( dmenu -p "Search unicode character:" < /dev/null )" 2> /dev/null )"
		[ -n "$query" ] && printf '%s\n' "$query" | dmenu -p "Select unicode character:"
	else
		echo "$_SELF: not a graphical session" >&2
		return 1
	fi
}


#==============================================================================#


# [$1: {get,clip,type} (get)]
main() { local action="${1:-get}"
	local char
	case "$action" in
		get ) _uniget ;;
		clip )
			char="$( _uniget )" ; sleep 0.1
			if [ -n "$char" ] ; then
				if [ "$XDG_SESSION_TYPE" = wayland ] && [ -n "$WAYLAND_DISPLAY" ] ; then
					echo -n "$char" | wl-copy -t text/plain -n
				elif [ "$XDG_SESSION_TYPE" = x11 ] && [ -n "$DISPLAY" ] ; then
					echo -n "$char" | xclip -r -selection clipboard
				else
					echo "$_SELF: not a graphical session" >&2
					return 1
				fi
			fi
		;;
		type )
			char="$( _uniget )" ; sleep 0.1
			if [ -n "$char" ] ; then
				if [ "$XDG_SESSION_TYPE" = wayland ] && [ -n "$WAYLAND_DISPLAY" ] ; then
					wtype -d 200 -- "$char"
				elif [ "$XDG_SESSION_TYPE" = x11 ] && [ -n "$DISPLAY" ] ; then
					xdotool sleep 0.2 type "$char"
				else
					echo "$_SELF: not a graphical session" >&2
					return 1
				fi
			fi
		;;
		* )
			echo "$_SELF: unknown action -- '$action'" >&2
			_usage 2
		;;
	esac
} ; main "$@"


#==============================================================================#
#                                 END OF FILE                                  #
#==============================================================================#
