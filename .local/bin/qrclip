#!/bin/sh
# vim:ft=sh:noet:ts=3:sw=3:
# man:qrencode(1)
# file:$XDG_BIN_DIR/qrclip
#==============================================================================#


# Who am I?
_SELF="${0##*/}"

# [$1: TEXT (CLIPBOARD)]
main() { local text="$1"
	if [ -z "$text" ] ; then
		if [ "$XDG_SESSION_TYPE" = wayland ] && [ -n "$WAYLAND_DISPLAY" ] ; then
			text="$( wl-paste -t text/plain -n )"
		elif [ "$XDG_SESSION_TYPE" = x11 ] && [ -n "$DISPLAY" ] ; then
			text="$( xclip -o -r -selection clipboard )"
		else
			echo "$_SELF: not a graphical session" >&2
			return 1
		fi
	fi
	[ -n "$text" ] && qrencode -o- -t SVG -- "$text" | imv -
} ; main "$@"


#==============================================================================#
#                                 END OF FILE                                  #
#==============================================================================#
