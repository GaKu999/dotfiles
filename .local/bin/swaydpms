#!/bin/sh
# vim:ft=sh:noet:ts=3:sw=3:
# file:$XDG_BIN_DIR/swaydpms
#==============================================================================#


# Who am I?
_SELF="${0##*/}"

_herecat() {
	local msg line lfcr
	lfcr="$( printf '%b' "\012\015" )"
	while IFS="$lfcr" read -r line ; do
		msg="$msg$line$lfcr"
	done
	printf '%s' "$msg"
}

# [$1: EXIT CODE (0)]
_usage() { local ec="${1:-0}"
	_herecat << ENDUSAGEMSG
Usage: $_SELF [{all,current,OUTPUT} (all)] [{toggle,on,off} (toggle)]
ENDUSAGEMSG
	exit "$ec"
}


#==============================================================================#


# $@: [{all,current,OUTPUT} (all)] [{toggle,on,off} (toggle)]
main() { local output="${1:-all}" action="${2:-toggle}"
	if [ -n "$SWAYSOCK" ] ; then
		case "$action" in
			toggle )
				case "$output" in
					all )
						case "$( swaymsg -t get_outputs | jq -r '.[].dpms' )" in
							*true* ) main all off ;;
							*false* ) main all on ;;
						esac
					;;
					current | * )
						[ "$output" = current ] && output="$( swaymsg -t get_outputs | jq -r '.[] | select(.focused==true).name' )"
						case "$( swaymsg -t get_outputs | jq -r ".[] | select(.name==\"$output\").dpms" )" in
							*true* ) main "$output" off ;;
							*false* ) main "$output" on ;;
						esac
					;;
				esac
			;;
			on )
				case "$output" in
					all ) swaymsg -q output '*' power on ;;
					current | * )
						[ "$output" = current ] && output="$( swaymsg -t get_outputs | jq -r '.[] | select(.focused==true).name' )"
						swaymsg -q output "$output" power on
					;;
				esac
			;;
			off )
				case "$output" in
					all ) swaymsg -q output '*' power off ;;
					current | * )
						[ "$output" = current ] && output="$( swaymsg -t get_outputs | jq -r '.[] | select(.focused==true).name' )"
						swaymsg -q output "$output" power off
					;;
				esac
			;;
			*)
				echo "$_SELF: unknown action -- '$action'" >&2
				_usage 2
			;;
		esac
	else
		echo "$_SELF: Unable to retrieve socket path" >&2
		return 1
	fi
} ; main "$@"


#==============================================================================#
#                                 END OF FILE                                  #
#==============================================================================#
